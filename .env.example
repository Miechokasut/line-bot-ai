# LINE Messaging API
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Google Gemini (@google/genai)
GEMINI_API_KEY=your_gemini_api_key
# ชื่อโมเดล (ไม่ตั้งก็ได้ default = gemini-2.5-flash) เช่น gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Google Sheet FAQ (published as CSV: File > Share > Publish to web > CSV)
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/xxxx/pub?output=csv
